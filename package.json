{
  "name": "extension-diet",
  "displayName": "Extension Diet",
  "description": "Keep VS Code lightweight per project by preventing irrelevant stack extensions from running in optimized windows.",
  "version": "0.1.1",
  "publisher": "harikahono",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harikahono/extension-diet.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "images/extension-diet.png",
  "contributes": {
    "commands": [
      {
        "command": "extensionDiet.showDetection",
        "title": "Extension Diet: Show Detection Result"
      },
      {
        "command": "extensionDiet.optimizeWorkspace",
        "title": "Extension Diet: Optimize Workspace"
      },
      {
        "command": "extensionDiet.neverDisable",
        "title": "Extension Diet: Never Disable This"
      },
      {
        "command": "extensionDiet.showLog",
        "title": "Extension Diet: Show Log"
      },
      {
        "command": "extensionDiet.resetRepoDecision",
        "title": "Extension Diet: Reset Repo Decision"
      },
      {
        "command": "extensionDiet.showOptimizationResult",
        "title": "Extension Diet: Show Optimization Result"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "tsc -p ./ && node ./out/check.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0"
  }
}
